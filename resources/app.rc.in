#include <windows.h>
1 RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/app.manifest"
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"
101 RCDATA "@NOTICES_PATH@"
103 RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"
102 WAVE "@CMAKE_CURRENT_SOURCE_DIR@/resources/replay-saved.wav"
104 WAVE "@CMAKE_CURRENT_SOURCE_DIR@/resources/screenshot-saved.wav"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OBSReplay"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "OBSReplay"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
